Index: dsh-multica-runtime/src/task-env.ts
===================================================================
--- dsh-multica-runtime.orig/src/task-env.ts
+++ dsh-multica-runtime/src/task-env.ts
@@ -1,9 +1,20 @@
-/** Return the one credential DSH child tools may receive from Multica. */
+/**
+ * Return the credentials DSH child tools may receive from Multica.
+ *
+ * Native mode forwards the server-minted `mat_` task token only. Odoo
+ * backend mode forwards the Galaxy credential pair the daemon injects
+ * (access token + api key), gated on MULTICA_BACKEND_MODE so an ambient
+ * token never travels without its daemon-issued companion.
+ */
 export function multicaTerminalEnvironment(
   environment: NodeJS.ProcessEnv,
 ): Record<string, string> {
   const token = environment.MULTICA_TOKEN
-  return token?.startsWith('mat_') === true && token.length > 4
-    ? { MULTICA_TOKEN: token }
-    : {}
+  if (token === undefined || token.length <= 4) return {}
+  if (token.startsWith('mat_')) return { MULTICA_TOKEN: token }
+  const apiKey = environment.MULTICA_ODOO_API_KEY
+  if (environment.MULTICA_BACKEND_MODE === 'odoo' && apiKey !== undefined && apiKey !== '') {
+    return { MULTICA_TOKEN: token, MULTICA_ODOO_API_KEY: apiKey }
+  }
+  return {}
 }
